# .env.example — copy to .env and fill in your values
# For Docker Compose and Django (via python-decouple)

# ── Django ──
SECRET_KEY=django-insecure-change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (used locally; Docker uses DATABASE_URL env var) ──
DB_NAME=coolbreeze
DB_USER=coolbreeze
DB_PASSWORD=coolbreeze
DB_HOST=localhost
DB_PORT=5432

# Full connection URL (used by Docker Compose + dj_database_url)
DATABASE_URL=postgres://coolbreeze:coolbreeze@localhost:5432/coolbreeze

# ── DeepSeek API ──
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# ── Docker Compose ──
DJANGO_SECRET_KEY=django-insecure-change-me-to-a-random-secret-key
DJANGO_DEBUG=True

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
